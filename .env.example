DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/birdwatching_moscow"

# Auth.js v5 — generate with: npx auth secret
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# App base URL — used to build ЮKassa return_url and the dev stub confirmation link
APP_URL="http://localhost:3000"

# ЮKassa (Smart payment) — see lib/env.ts and lib/payments/yookassa/
# "stub" runs the whole payment flow locally with zero outbound HTTP and no credentials.
# Switching to "live" is an env-only change; missing required fields throw at startup.
YOOKASSA_MODE="stub"
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_API_URL="https://api.yookassa.ru/v3"
# Verify inbound webhook notifications against the ЮKassa IP allowlist.
# In production nginx sets X-Real-IP; locally there is no proxy, so set this to
# "false" to exercise the dev stub confirmation page end-to-end.
YOOKASSA_VERIFY_IP="true"
# 54-ФЗ: the merchant uses «Чеки от ЮKassa» — receipts are mandatory in live mode
YOOKASSA_RECEIPT_ENABLED="true"
YOOKASSA_VAT_CODE=""
