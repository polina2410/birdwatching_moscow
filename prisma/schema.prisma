datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts, not here (Prisma 7)
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum EventStatus {
  DRAFT
  ACTIVE
  CANCELLED
  DELETED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FAILED
  EXPIRED
}

enum RequestType {
  PRIVATE_WALK
  EXPEDITION
}

enum RequestStatus {
  NEW
  WAITLIST
}

model User {
  id           String    @id @default(uuid())
  // NOTE: NOT @unique — uniqueness is a partial index WHERE "deletedAt" IS NULL, added via raw SQL in migration
  email        String    @db.VarChar(254)
  // NOTE: nullable — USER accounts are passwordless and sign in with an emailed one-time code
  passwordHash String?
  name         String    @db.VarChar(50)
  role         Role      @default(USER)
  // NOTE: forces ADMIN/SUPERADMIN password rotation after PASSWORD_MIN_LENGTH was raised to 16
  passwordResetRequired Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  blockedAt    DateTime?

  orders               Order[]
  tickets              Ticket[]
  cartItems            CartItem[]
  publishedWalks       Walk[]               @relation("WalkPublisher")
  publishedExpeditions Expedition[]         @relation("ExpeditionPublisher")
  passwordResetTokens  PasswordResetToken[]
  roleChangesAsTarget  RoleChangeLog[]      @relation("RoleChangeTarget")
  roleChangesAsChanger RoleChangeLog[]      @relation("RoleChangeChanger")
}

model Walk {
  id            String      @id @default(uuid())
  slug          String      @unique @db.VarChar(200)
  title         String      @db.VarChar(150)
  description   String      @db.Text
  startsAt      DateTime
  duration      String?     @db.VarChar(100)
  location      String      @db.VarChar(100)
  priceKopecks  Int
  capacity      Int
  guideId       Int
  status        EventStatus @default(DRAFT)
  coverPhotoUrl String      @db.VarChar(2048)
  galleryUrl    String?     @db.VarChar(2048)
  publishedAt   DateTime?
  publishedBy   String?
  createdAt     DateTime    @default(now())

  guide      TeamMember  @relation(fields: [guideId], references: [id])
  publisher  User?       @relation("WalkPublisher", fields: [publishedBy], references: [id])
  tickets    Ticket[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([status, startsAt])
}

model Expedition {
  id            String      @id @default(uuid())
  slug          String      @unique @db.VarChar(200)
  title         String      @db.VarChar(150)
  description   String      @db.Text
  startsAt      DateTime
  endsAt        DateTime?
  location      String      @db.VarChar(100)
  totalSpots    Int
  spotsLeft     Int
  status        EventStatus @default(DRAFT)
  coverPhotoUrl String      @db.VarChar(2048)
  galleryUrls   String[]
  publishedAt   DateTime?
  publishedBy   String?
  createdAt     DateTime    @default(now())

  guides    TeamMember[]
  publisher User?          @relation("ExpeditionPublisher", fields: [publishedBy], references: [id])
  days      ExpeditionDay[]
  requests  Request[]

  @@index([status, startsAt])
}

model ExpeditionDay {
  id           String @id @default(uuid())
  expeditionId String
  dayNumber    Int
  title        String @db.VarChar(150)
  description  String @db.Text

  expedition Expedition @relation(fields: [expeditionId], references: [id])
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  photoUrl     String   @db.VarChar(2048)
  education    String?  @db.Text
  achievements String?  @db.Text
  profileLinks String[]
  sortOrder    Int

  walks       Walk[]
  expeditions Expedition[]
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  status            OrderStatus @default(PENDING)
  totalKopecks      Int
  // NOTE: unique index supports idempotent webhook matching — ЮKassa may deliver the same event twice
  yooKassaPaymentId String?     @unique @db.VarChar(100)
  // End of the payment window: now + PAYMENT_HOLD_MINUTES, set at checkout. Lazy-on-read expiry.
  expiresAt         DateTime
  paidAt            DateTime?
  // Non-null flags an order for manual admin attention (amount mismatch, oversell, unexpected provider state)
  paymentIssue      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  tickets    Ticket[]
  orderItems OrderItem[]

  @@index([status, expiresAt])
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  walkId           String
  quantity         Int
  // Snapshot of Walk.priceKopecks at checkout time — a later admin price edit must not change an in-flight order
  unitPriceKopecks Int
  createdAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  walk  Walk  @relation(fields: [walkId], references: [id])

  @@index([walkId])
}

model Ticket {
  id        String   @id @default(uuid())
  orderId   String
  userId    String
  walkId    String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  walk  Walk  @relation(fields: [walkId], references: [id])

  @@index([userId])
}

model CartItem {
  id            String   @id @default(uuid())
  userId        String
  walkId        String
  quantity      Int
  // Set by app to now + 20 min. Active reservation = reservedUntil > now; expired rows filtered lazily on read.
  reservedUntil DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  walk Walk @relation(fields: [walkId], references: [id])

  @@index([reservedUntil])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model LoginCode {
  id String @id @default(uuid())
  // NOTE: keyed by email, not userId — the request endpoint does identical work whether or not the account exists
  email String @db.VarChar(254)
  // NOTE: deliberately NOT @unique — the 6-char space makes collisions realistic; always look up email + codeHash together
  codeHash  String    @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email])
}

model Request {
  id           String        @id @default(uuid())
  type         RequestType
  // NOTE: set for EXPEDITION requests, null for PRIVATE_WALK
  expeditionId String?
  name         String        @db.VarChar(100)
  email        String        @db.VarChar(254)
  message      String        @db.Text
  status       RequestStatus @default(NEW)
  createdAt    DateTime      @default(now())

  expedition Expedition? @relation(fields: [expeditionId], references: [id])

  @@index([status])
}

model RoleChangeLog {
  id              String   @id @default(uuid())
  targetUserId    String
  changedByUserId String
  fromRole        Role
  toRole          Role
  createdAt       DateTime @default(now())

  targetUser    User @relation("RoleChangeTarget", fields: [targetUserId], references: [id])
  changedByUser User @relation("RoleChangeChanger", fields: [changedByUserId], references: [id])

  @@index([targetUserId])
  @@index([createdAt])
}
